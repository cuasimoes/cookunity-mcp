{
  "name": "cookunity-mcp-server",
  "version": "1.3.4",
  "description": "Unofficial MCP server for CookUnity meal delivery — browse menus, manage carts, confirm orders, skip deliveries. Not affiliated with CookUnity.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cookunity-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "cookunity",
    "meal-delivery",
    "model-context-protocol",
    "ai",
    "llm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ggonzalezaleman/cookunity-mcp.git"
  },
  "license": "MIT",
  "author": "Guille Gonzalez",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "rm -rf dist",
    "verify:token": "tsx scripts/verify/check-token.mts",
    "verify:menu": "tsx scripts/verify/verify-menu.mts",
    "verify:smoke": "npm run build && tsx scripts/verify/smoke-mcp.mts",
    "probe:fields": "tsx scripts/verify/probe-field-shapes.mts",
    "probe:nutrition": "tsx scripts/verify/probe-nutrition-fields.mts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "axios": "^1.7.9",
    "axios-cookiejar-support": "^6.0.5",
    "express": "^4.21.0",
    "tough-cookie": "^6.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/tough-cookie": "^4.0.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
